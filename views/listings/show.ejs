<% layout('/layouts/boilerplate') -%>

<div class="row">
    <div class="col-8 offset-3 mt-3">
        <h3><%= specificListing.title %></h3>
    </div>
    <div class="card col-6 offset-3 mt-1">
        <img src="<%= specificListing.image %>" class="card-img-top show-img" alt="property_image">
        <div class="card-body">
            <p class="card-text mt-1"> 
                <i>Owned by <%= specificListing.owner.username %></i>
            </p>
            <p class="card-text mt-1"> 
                <%= specificListing.description %>
            </p>
            <p class="card-text mt-1">
                &#8377; <%= specificListing.price.toLocaleString("en-IN") %> <br/>
                <%= specificListing.location %><b>,</b> 
                <%= specificListing.country %>
            </p>
        </div>
    </div>

    <% if(currUser && currUser._id.equals(specificListing.owner._id)){ %>
        <div class="btns">
            <a href="/listings/<%= specificListing._id %>/edit" 
            class="btn btn-dark all-btns col-2 col-md-1 offset-3">
                Edit 
            </a>
            <form method="post" action="/listings/<%= specificListing._id %>?_method=DELETE">
                <button class="btn btn-dark offset-5">Delete</button>
            </form>
        </div>
    <% } %>    


    <% if(currUser){ %>
        <div class="col-8 offset-3 mb-3">
            <hr/>
            <h4>Write a Review</h4>
            <form method="post" action="/listings/<%= specificListing.id %>/reviews" novalidate class="needs-validation">
                <div class="mt-3">
                    <label class="form-label">Rating</label>
                    <fieldset class="starability-slot">
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value=""  aria-label="No rating." />

                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>

                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" checked/>
                        <label for="first-rate3" title="Average">3 stars</label>

                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>

                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        
                    </fieldset>
                    <div id="ratingError" class="invalid-feedback" style="display: none;">
                        Please add rating for review
                    </div>
                </div>
                <div class="mb-3">
                    <label for="comment" class="form-label">Comment</label>
                    <textarea name="review[comment]" id="comment" cols="20" rows="5" class="form-control" required></textarea>
                    <div class="invalid-feedback">
                        Please add some comments for review
                    </div>
                </div>
                <button class="btn btn-outline-dark">Submit</button>
            </form>
        </div>
    <% } %>

    <hr/>
    <div>
        <p><b>All Reviews</b></p>
        <div class="row">
            <% for( review of specificListing.reviews ) { %>
                <div class="review-display col-md-4 col-lg-3 mb-4 col-sm-6">
                    <h5 class="review-author"><%= review.author.username %></h5>
                    <p class="comment-box"><%= review.comment %></p>
                    <p class="starability-result" data-rating="<%= review.rating %>">
                    </p>
                    <div class="review-date">
                        <p >
                        <%= review.createdAt.toLocaleDateString('en-GB', { 
                        month: 'long', 
                        year: 'numeric' 
                        }) %>
                        </p>
                        <% if(currUser && currUser._id.equals(review.author._id)){ %>
                            <form method="post" action="/listings/<%= specificListing.id %>/reviews/<%= review._id %>?_method=DELETE">
                                <button class="btn btn-sm btn-outline-dark">Delete</button>
                            </form>
                        <% } %>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
</div>
